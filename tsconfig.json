{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "moduleResolution": "bundler",
      "outDir": "./dist",
      "types": ["bun", "node"],
      "strict": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
  }
  